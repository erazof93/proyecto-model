# ============================================================================
# .env.example - Plantilla de variables de entorno
# Copiar a .env.local y rellenar con valores reales:
#   cp .env.example .env.local
# ============================================================================

# --- Base de datos: PostgreSQL local (docker-compose) -----------------------
# Cadena de conexión. Debe coincidir con POSTGRES_USER / POSTGRES_PASSWORD /
# POSTGRES_DB del servicio "postgres" en docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/proyecto_model

# --- Cloudinary (gestión de imágenes) -------------------------------------
# Nombre del cloud de tu cuenta Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# API key pública de Cloudinary
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_api_key

# Upload preset "unsigned" para subidas desde el navegador
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=unsigned_preset

# --- URLs del sitio -------------------------------------------------------
# URL base del frontend (client)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auth local ---------------------------------------------------------------
# Secreto para firmar/verificar JWT de sesión. CAMBIAR en producción.
JWT_SECRET=change-me-in-production
