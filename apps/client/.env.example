# ============================================================================
# apps/client/.env.example
#
# Next.js SÓLO lee .env(.local) desde el directorio de la app (apps/client/),
# NO desde la raíz del monorepo. Copia este fichero a apps/client/.env.local
# y rellena los valores (o duplica el .env.local de la raíz):
#
#   cp apps/client/.env.example apps/client/.env.local
# ============================================================================

# --- Base de datos --------------------------------------------------------
# Opción A: cadena de conexión completa.
#   - Local (docker-compose):  postgresql://postgres:postgres@localhost:5434/proyecto_model
#   - Supabase (dev, directo): postgresql://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres
#   - Vercel/prod: usa el POOLER de Supabase (puerto 6543, modo transaction):
#       postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/proyecto_model

# Opción B (si no defines DATABASE_URL): variables discretas.
# DB_HOST=localhost
# DB_PORT=5434
# DB_NAME=proyecto_model
# DB_USER=postgres
# DB_PASSWORD=postgres

# SSL: automático (on para hosts remotos, off para localhost). Fuerza con:
# DB_SSL=true
# DB_SSL=false

# Tope de conexiones del pool por instancia (serverless). Por defecto 3.
# DB_POOL_MAX=3

# --- Cloudinary ---------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_api_key
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=unsigned_preset

# --- Sitio ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auth -----------------------------------------------------------------
JWT_SECRET=change-me-in-production
