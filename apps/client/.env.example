# ============================================================================
# apps/client/.env.example
#
# Next.js SÓLO lee .env(.local) desde apps/client/, NO desde la raíz del
# monorepo. Copia este fichero y rellena los valores:
#   cp apps/client/.env.example apps/client/.env.local
# ============================================================================

# --- Base de datos: elige UNA opción -------------------------------------

# Opción A: Supabase Pooler (parecido a producción, necesita internet).
#   Session mode  -> puerto 5432 (recomendado con TypeORM/pg).
#   Transaction   -> puerto 6543, añade "?pgbouncer=true".
DATABASE_URL=postgresql://postgres.XXXXXXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Opción B: Docker local (necesita `docker compose up -d postgres`).
# Comenta DATABASE_URL y descomenta:
# DB_HOST=localhost
# DB_PORT=5434
# DB_NAME=proyecto_model
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL=false

# SSL: automático (on para hosts remotos, off para localhost). Forzar con:
# DB_SSL=true | DB_SSL=false
# Tope de conexiones del pool por instancia serverless (por defecto 3):
# DB_POOL_MAX=3

# --- JWT / Auth ---------------------------------------------------------------
JWT_SECRET=your-super-secret-key-change-in-production

# --- Cloudinary -------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_api_key
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_preset

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_TELEGRAM_USERNAME=@your_telegram_username
