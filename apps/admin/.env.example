# ============================================================================
# apps/admin/.env.example
#
# Next.js SÓLO lee .env(.local) desde apps/admin/, NO desde la raíz del
# monorepo ni desde apps/client/. Copia este fichero y rellena los valores:
#   cp apps/admin/.env.example apps/admin/.env.local
# ============================================================================

# --- Base de datos: elige UNA opción -----------------------------------------
# Misma BD que apps/client.
#
# Opción A: Supabase Pooler.
#   Transaction mode -> puerto 6543, añade "?pgbouncer=true".
#   Session mode     -> puerto 5432.
DATABASE_URL=postgresql://postgres.XXXXXXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Opción B: Docker local (necesita `docker compose up -d postgres`).
# Comenta DATABASE_URL y descomenta:
# DB_HOST=localhost
# DB_PORT=5434
# DB_NAME=proyecto_model
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL=false

# SSL: automático (on para hosts remotos, off para localhost). Forzar con:
# DB_SSL=true | DB_SSL=false
# Tope de conexiones del pool por instancia (por defecto 3):
# DB_POOL_MAX=3

# --- JWT / Auth -------------------------------------------------------------
# DEBE ser el MISMO valor que apps/client/.env.local (misma tabla `users`).
JWT_SECRET=your-super-secret-key-change-in-production
